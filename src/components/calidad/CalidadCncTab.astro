---
import CalidadCncApp from './CalidadCncApp';
---

<div>
  <header class="mb-6">
    <h2 class="text-lg font-semibold text-slate-100">Calidad (CNC)</h2>
    <p class="mt-1 text-sm text-slate-400">
      Indicador de Costo de No Calidad para el tablero gerencial. Las notas de crédito, la facturación y los pedidos
      salen de Odoo según el mes elegido. Flete extra, horas, valor hora y recupero se editan acá mismo.
    </p>
  </header>

  <CalidadCncApp client:only="react" />
</div>
