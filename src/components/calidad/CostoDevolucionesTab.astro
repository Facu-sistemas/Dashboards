---
import { getCostoDevolucionesData } from '../../lib/odoo/costo-devoluciones';
import { getTarifasGuardadas } from '../../lib/supabase/costo-devoluciones-tarifas';
import type { CostoDevolucionesData } from '../../lib/odoo/costo-devoluciones';
import type { TarifasGuardadas } from '../../lib/supabase/costo-devoluciones-tarifas';

let data: CostoDevolucionesData | null = null;
let tarifas: TarifasGuardadas = { disponible: false, porMes: {} };
let ssrError: string | null = null;
try {
  [data, tarifas] = await Promise.all([getCostoDevolucionesData(), getTarifasGuardadas()]);
} catch (err) {
  ssrError = err instanceof Error ? err.message : 'Error desconocido consultando Odoo';
}

// `<` escapado para que ningún nombre pueda cerrar el <script>.
const json = data ? JSON.stringify({ data, tarifas }).replace(/</g, '\\u003c') : '';

const SQL = `create table costo_devoluciones_tarifas (
  mes text primary key check (mes ~ '^[0-9]{4}-[0-9]{2}$'),
  costo_hora numeric not null default 0,
  viajes numeric not null default 2,
  fletes jsonb not null default '{}',
  actualizado_por text,
  updated_at timestamptz not null default now()
);
alter table costo_devoluciones_tarifas enable row level security;
grant select, insert, update, delete on public.costo_devoluciones_tarifas to service_role;`;

// Para quien ya había migrado la tabla a la versión por km (idempotente: sirve en cualquier estado).
const SQL_MIGRACION = `alter table costo_devoluciones_tarifas
  add column if not exists fletes jsonb not null default '{}',
  drop column if exists costo_km,
  drop column if exists factor_ruta;`;

const inputClass =
  'mt-1 w-full rounded border border-slate-700 bg-slate-950 px-3 py-1.5 text-slate-200 focus:border-brand-500 focus:outline-none';
const card = 'rounded-lg border border-slate-800 bg-slate-900 p-4';
---

<div>
  <header class="mb-6">
    <h2 class="text-lg font-semibold text-slate-100">Costo de no calidad</h2>
    <p class="mt-1 text-sm text-slate-400">
      Cuánto nos cuesta por mes lo que vuelve o se rompe: flete de ida y vuelta, horas de reparación y el material o
      producto que se pierde, menos lo que se le factura al transportista o al cliente. Colchón sale de las notas de
      crédito; Living, de las reparaciones del soporte al cliente. El flete y la hora se cargan acá y se guardan mes a mes.
    </p>
  </header>

  {
    ssrError && (
      <p class="mb-6 rounded border border-red-900 bg-red-950/50 p-3 text-sm text-red-300">
        No se pudo consultar Odoo ({ssrError}).
      </p>
    )
  }

  {
    data && !tarifas.disponible && (
      <div class="mb-6 rounded border border-amber-900 bg-amber-950/40 p-3 text-sm text-amber-200">
        <p>
          Las tarifas todavía no se pueden guardar: falta crear (o actualizar) la tabla en Supabase. Mientras tanto la
          pantalla funciona, pero los valores se pierden al recargar. Ejecutá esto en el SQL Editor de Supabase:
        </p>
        <pre class="mt-2 overflow-x-auto rounded bg-slate-950 p-3 text-xs text-slate-300">{SQL}</pre>
        <p class="mt-3">Si la tabla ya existe, ejecutá solo esto:</p>
        <pre class="mt-2 overflow-x-auto rounded bg-slate-950 p-3 text-xs text-slate-300">{SQL_MIGRACION}</pre>
      </div>
    )
  }

  {
    data && (
      <>
        <section class={`mb-6 grid gap-4 sm:grid-cols-3 ${card}`}>
          <label class="block text-sm text-slate-400">
            Mes
            <select id="cd-mes" class={inputClass}></select>
          </label>
          <label class="block text-sm text-slate-400">
            Sector
            <select id="cd-sector" class={inputClass}>
              <option value="todos">Living y Colchón</option>
              <option value="living">Living</option>
              <option value="colchon">Colchón</option>
            </select>
          </label>
          <label class="block text-sm text-slate-400">
            Empresa
            <select id="cd-empresa" class={inputClass}>
              <option value="0">Todas</option>
              {data.empresas.map((e) => <option value={e.id}>{e.name}</option>)}
            </select>
          </label>
        </section>

        <section class="mb-6 grid gap-3 lg:grid-cols-3">
          <div class={`lg:col-span-2 ${card}`}>
            <p class="text-xs text-slate-400">Costo neto de no calidad — <span id="cd-hero-mes"></span></p>
            <p id="cd-hero" class="mt-1 text-4xl font-semibold text-status-red">—</p>
            <p id="cd-hero-sub" class="mt-2 text-sm text-slate-400"></p>
            <div id="cd-comp-bar" class="mt-4 flex h-3 overflow-hidden rounded bg-slate-800"></div>
            <div id="cd-comp-leyenda" class="mt-2 flex flex-wrap gap-x-5 gap-y-1 text-xs text-slate-400"></div>
          </div>
          <div class="grid grid-cols-2 gap-3 lg:grid-cols-1">
            <div class={card} id="cd-card-living">
              <p class="text-xs text-slate-400">Living: devoluciones cada 1.000 fabricadas</p>
              <p id="cd-kpi-living" class="mt-1 text-2xl font-semibold text-slate-100">—</p>
              <p id="cd-kpi-living-sub" class="mt-1 text-xs text-slate-500"></p>
            </div>
            <div class={card} id="cd-card-colchon">
              <p class="text-xs text-slate-400">Colchón: devoluciones cada 1.000 fabricadas</p>
              <p id="cd-kpi-colchon" class="mt-1 text-2xl font-semibold text-slate-100">—</p>
              <p id="cd-kpi-colchon-sub" class="mt-1 text-xs text-slate-500"></p>
            </div>
          </div>
        </section>

        <section class="mb-6">
          <h3 class="mb-2 text-sm font-medium text-slate-200">Por motivo</h3>
          <div id="cd-causas" class="grid gap-3 sm:grid-cols-2 lg:grid-cols-5"></div>
        </section>

        <section class={`mb-6 ${card}`}>
          <h3 class="mb-1 text-sm font-medium text-slate-200">Mes a mes</h3>
          <p class="mb-3 text-xs text-slate-500">Costo neto de cada mes con las tarifas de ese mes. Tocá un mes para verlo en detalle.</p>
          <div id="cd-serie" class="space-y-1"></div>
        </section>

        <section id="cd-datos-card" class="mb-6 hidden rounded-lg border border-amber-900 bg-amber-950/30 p-4">
          <h3 class="mb-1 text-sm font-medium text-amber-200">Datos que faltan en Odoo</h3>
          <p class="mb-2 text-xs text-amber-200/70">Cada uno de estos casos hace que el costo real sea distinto del que se ve acá.</p>
          <ul id="cd-datos" class="list-disc space-y-1 pl-5 text-sm text-amber-100/90"></ul>
        </section>

        <details class={`mb-6 ${card}`}>
          <summary class="cursor-pointer text-sm font-medium text-slate-200">
            Tarifas de <span id="cd-tarifas-mes"></span> <span id="cd-tarifas-estado" class="ml-2 text-xs font-normal text-slate-500"></span>
          </summary>
          <div class="mt-4 grid gap-4 sm:grid-cols-2">
            <label class="block text-sm text-slate-400">
              Valor de la hora de reparación ($)
              <input id="cd-hora" type="number" min="0" step="any" inputmode="decimal" class={inputClass} />
              <span class="mt-1 block text-xs text-slate-500">Lo que vale una hora de esa persona: lo que costó pagarla y lo que se dejó de producir. Ej.: 3 horas de un Luxor = $60.000 → $20.000.</span>
            </label>
            <label class="block text-sm text-slate-400">
              Viajes de flete por devolución
              <input id="cd-viajes" type="number" min="0" step="1" inputmode="numeric" class={inputClass} />
              <span class="mt-1 block text-xs text-slate-500">2 = el envío original + la vuelta. 3 si además se reenvía reparado.</span>
            </label>
          </div>

          <div class="mt-5 flex flex-wrap items-end justify-between gap-3">
            <div>
              <h4 class="text-sm font-medium text-slate-200">Flete por provincia</h4>
              <p class="mt-1 text-xs text-slate-500">Costo de un viaje a cada provincia. Si una provincia queda vacía, el flete se estima con el recargo de la región del cliente (el % que ya se le cobra en la nota de venta) sobre el valor del producto.</p>
            </div>
            <div class="flex gap-2">
              <input id="cd-flete-todas" type="number" min="0" step="any" inputmode="decimal" placeholder="Mismo valor para todas" class="w-48 rounded border border-slate-700 bg-slate-950 px-3 py-1.5 text-sm text-slate-200 placeholder:text-slate-500 focus:border-brand-500 focus:outline-none" />
              <button id="cd-flete-aplicar" type="button" class="rounded border border-slate-700 px-3 py-1.5 text-sm text-slate-200 hover:bg-slate-800">Aplicar</button>
            </div>
          </div>
          <div id="cd-fletes" class="mt-3 grid gap-x-6 gap-y-2 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4"></div>

          <div class="mt-4 flex flex-wrap items-center gap-3">
            <button id="cd-guardar" type="button" class="rounded bg-brand-500 px-4 py-1.5 text-sm font-medium text-white hover:bg-brand-600 disabled:cursor-not-allowed disabled:opacity-50">Guardar tarifas del mes</button>
            <p id="cd-guardar-msg" class="text-sm text-slate-400" role="status"></p>
          </div>
        </details>

        <section class={`mb-6 ${card}`}>
          <div class="mb-2 flex flex-wrap items-center justify-between gap-2">
            <h3 class="text-sm font-medium text-slate-200">Resumen</h3>
            <button id="cd-pdf" type="button" class="rounded border border-slate-700 px-3 py-1.5 text-sm text-slate-200 hover:bg-slate-800 disabled:opacity-50">Descargar PDF</button>
          </div>
          <p id="cd-resumen" class="text-sm leading-relaxed text-slate-300"></p>
        </section>

        <section class={`mb-6 ${card}`}>
          <h3 class="mb-3 text-sm font-medium text-slate-200">Por provincia</h3>
          <div class="overflow-x-auto">
            <table class="w-full text-left text-sm">
              <thead class="text-xs text-slate-400">
                <tr class="border-b border-slate-800">
                  <th class="py-2 pr-4 font-medium">Provincia</th>
                  <th class="py-2 pr-4 text-right font-medium">Living</th>
                  <th class="py-2 pr-4 text-right font-medium">Colchón</th>
                  <th class="py-2 pr-4 text-right font-medium">Recargo región</th>
                  <th class="py-2 pr-4 text-right font-medium">Flete</th>
                  <th class="py-2 pr-4 text-right font-medium">Mano de obra</th>
                  <th class="py-2 pr-4 text-right font-medium">Material</th>
                  <th class="py-2 pr-4 text-right font-medium">Facturado</th>
                  <th class="py-2 pr-4 text-right font-medium">Costo neto</th>
                  <th class="py-2 text-right font-medium">Notas de crédito</th>
                </tr>
              </thead>
              <tbody id="cd-tbody"></tbody>
              <tfoot id="cd-tfoot"></tfoot>
            </table>
            <p id="cd-vacio" class="hidden py-6 text-center text-sm text-slate-500">No hubo casos con estos filtros.</p>
          </div>
        </section>

        <section class={card}>
          <h3 class="mb-1 text-sm font-medium text-slate-200">Detalle de casos</h3>
          <p class="mb-3 text-xs text-slate-500">Cada fila es una orden de reparación o una nota de crédito, ordenadas por costo neto. "~" marca un flete estimado con el recargo de la región.</p>
          <div class="overflow-x-auto">
            <table class="w-full text-left text-sm">
              <thead class="text-xs text-slate-400">
                <tr class="border-b border-slate-800">
                  <th class="py-2 pr-4 font-medium">Caso</th>
                  <th class="py-2 pr-4 font-medium">Cliente</th>
                  <th class="py-2 pr-4 font-medium">Provincia</th>
                  <th class="py-2 pr-4 font-medium">Sector</th>
                  <th class="py-2 pr-4 font-medium">Motivo</th>
                  <th class="py-2 pr-4 text-right font-medium">Horas</th>
                  <th class="py-2 pr-4 text-right font-medium">Flete</th>
                  <th class="py-2 pr-4 text-right font-medium">Mano de obra</th>
                  <th class="py-2 pr-4 text-right font-medium">Material</th>
                  <th class="py-2 pr-4 text-right font-medium">Facturado</th>
                  <th class="py-2 text-right font-medium">Costo neto</th>
                </tr>
              </thead>
              <tbody id="cd-casos"></tbody>
            </table>
            <p id="cd-casos-mas" class="hidden pt-3 text-center text-xs text-slate-500"></p>
          </div>
          <p class="mt-3 text-xs text-slate-500">
            Devoluciones del índice = Living: órdenes de reparación terminadas; Colchón: notas de crédito de Calidad, Garantía
            y Logística (los descuentos y acuerdos comerciales no cuentan). Las horas incluyen reparaciones de Colchón. El
            material es lo que no se recupera: costo del producto menos lo recuperado al desarmarlo (Living) o costo del
            colchón devuelto (Colchón). La provincia es la del cliente.
          </p>
        </section>

        <div id="cd-data" data-json={json} hidden></div>
      </>
    )
  }
</div>

<script>
  import {
    CAUSAS,
    CAUSA_AYUDA,
    CAUSA_LABEL,
    SECTOR_LABEL,
    armarResumen,
    calcular,
    fmt,
    fmtHoras,
    fmtMil,
    fmtMonto,
    fmtPct,
    mesCorto,
    mesLabel,
    positivo,
    serieMensual,
    tarifasDeMes,
    type Filtros,
    type Resultado,
  } from './costo-devoluciones-calc';
  import type { CostoDevolucionesData } from '../../lib/odoo/costo-devoluciones';
  import type { TarifasGuardadas, TarifasMes } from '../../lib/supabase/costo-devoluciones-tarifas';

  const raw = document.getElementById('cd-data')?.dataset.json;

  if (raw) {
    const { data, tarifas: guardadas } = JSON.parse(raw) as { data: CostoDevolucionesData; tarifas: TarifasGuardadas };
    const $ = <T extends HTMLElement>(id: string) => document.getElementById(id) as T;

    const mesSel = $<HTMLSelectElement>('cd-mes');
    const sectorSel = $<HTMLSelectElement>('cd-sector');
    const empresaSel = $<HTMLSelectElement>('cd-empresa');
    const horaIn = $<HTMLInputElement>('cd-hora');
    const viajesIn = $<HTMLInputElement>('cd-viajes');
    const todasIn = $<HTMLInputElement>('cd-flete-todas');
    const fletesBox = $('cd-fletes');
    const guardarBtn = $<HTMLButtonElement>('cd-guardar');
    const guardarMsg = $('cd-guardar-msg');
    const pdfBtn = $<HTMLButtonElement>('cd-pdf');

    for (const m of data.meses) mesSel.add(new Option(mesLabel(m), m));
    mesSel.value = data.mesActual;
    guardarBtn.disabled = !guardadas.disponible;

    const filtros = (): Filtros => ({
      mes: mesSel.value,
      sector: sectorSel.value as Filtros['sector'],
      empresa: Number(empresaSel.value),
    });

    // Tarifas del mes en edición. Un mes sin guardar hereda las del último mes anterior guardado.
    let tarifas: TarifasMes = { costoHora: 0, viajes: 2, fletes: {} };
    let dirty = false;
    let origen = '';

    const fechaLarga = (iso: string) =>
      new Intl.DateTimeFormat('es-AR', { timeZone: 'America/Argentina/Buenos_Aires', dateStyle: 'short', timeStyle: 'short' }).format(new Date(iso));

    function cargarTarifasDelMes() {
      const mes = mesSel.value;
      const r = tarifasDeMes(guardadas.porMes, mes);
      tarifas = r.tarifas;
      dirty = false;
      const propio = guardadas.porMes[mes];
      origen = propio
        ? `Guardadas${propio.actualizadoPor ? ` por ${propio.actualizadoPor}` : ''} el ${fechaLarga(propio.updatedAt)}`
        : r.heredadoDe
          ? `Sin guardar para este mes: se partió de las de ${mesLabel(r.heredadoDe)}`
          : 'Sin tarifas guardadas todavía';
      horaIn.value = tarifas.costoHora ? String(tarifas.costoHora) : '';
      viajesIn.value = String(tarifas.viajes);
      guardarMsg.textContent = '';
    }

    function el<K extends keyof HTMLElementTagNameMap>(tag: K, text?: string, className?: string): HTMLElementTagNameMap[K] {
      const e = document.createElement(tag);
      if (text !== undefined) e.textContent = text;
      if (className) e.className = className;
      return e;
    }

    const celda = (tr: HTMLElement, text: string, className = '') => tr.append(el('td', text, `py-2 pr-4 tabular-nums ${className}`));
    const monto = (n: number) => (n === 0 ? '—' : fmtMonto(n));

    let resultado: Resultado;

    function renderHero(r: Resultado, f: Filtros) {
      const t = r.totales;
      $('cd-hero-mes').textContent = mesLabel(f.mes);
      $('cd-hero').textContent = t.bruto > 0 ? fmtMonto(t.neto) : t.casos > 0 ? 'Cargá las tarifas' : fmtMonto(0);
      const partes = [`${fmt(t.casos)} ${t.casos === 1 ? 'caso' : 'casos'}`];
      if (r.netoPorUnidad !== null && t.bruto > 0) partes.push(`${fmtMonto(r.netoPorUnidad)} por unidad fabricada (${fmt(r.unidades)} unidades)`);
      if (t.facturado > 0) partes.push(`${fmtMonto(t.bruto)} de costo − ${fmtMonto(t.facturado)} facturado`);
      $('cd-hero-sub').textContent = partes.join(' · ');

      const bar = $('cd-comp-bar');
      const leyenda = $('cd-comp-leyenda');
      bar.replaceChildren();
      leyenda.replaceChildren();
      const comps = [
        { k: 'Flete', v: t.flete, c: 'bg-brand-500' },
        { k: 'Mano de obra', v: t.manoObra, c: 'bg-status-yellow' },
        { k: 'Material y producto perdido', v: t.material, c: 'bg-status-red' },
      ];
      for (const c of comps) {
        if (t.bruto > 0 && c.v > 0) {
          const seg = el('div', undefined, c.c);
          seg.style.width = `${(c.v / t.bruto) * 100}%`;
          bar.append(seg);
        }
        const item = el('span', undefined, 'inline-flex items-center gap-1.5');
        item.append(el('span', undefined, `inline-block h-2 w-2 rounded-sm ${c.c}`), el('span', `${c.k}: ${fmtMonto(c.v)}`));
        leyenda.append(item);
      }
    }

    function renderIndices(r: Resultado, f: Filtros) {
      $('cd-card-living').classList.toggle('hidden', f.sector === 'colchon');
      $('cd-card-colchon').classList.toggle('hidden', f.sector === 'living');
      $('cd-kpi-living').textContent = fmtMil(r.living.porMil);
      $('cd-kpi-living-sub').textContent = `${fmt(r.living.devoluciones)} sobre ${fmt(r.living.unidades)} unidades`;
      $('cd-kpi-colchon').textContent = fmtMil(r.colchon.porMil);
      $('cd-kpi-colchon-sub').textContent = `${fmt(r.colchon.devoluciones)} sobre ${fmt(r.colchon.unidades)} unidades`;
    }

    function renderCausas(r: Resultado) {
      const box = $('cd-causas');
      box.replaceChildren();
      for (const causa of CAUSAS) {
        const m = r.porCausa[causa];
        const c = el('div', undefined, 'rounded-lg border border-slate-800 bg-slate-900 p-3');
        c.title = CAUSA_AYUDA[causa];
        c.append(el('p', CAUSA_LABEL[causa], 'text-xs text-slate-400'));
        c.append(el('p', m.casos > 0 && r.totales.bruto > 0 ? fmtMonto(m.neto) : '—', 'mt-1 text-lg font-semibold text-slate-100 tabular-nums'));
        const sub = m.casos === 0 ? 'Sin casos' : `${fmt(m.casos)} ${m.casos === 1 ? 'caso' : 'casos'}${m.facturado > 0 ? ` · ${fmtMonto(m.facturado)} facturado` : ''}`;
        c.append(el('p', sub, 'mt-1 text-xs text-slate-500'));
        box.append(c);
      }
    }

    function renderSerie() {
      const f = filtros();
      const serie = serieMensual(data, { sector: f.sector, empresa: f.empresa }, (mes) =>
        mes === f.mes ? tarifas : tarifasDeMes(guardadas.porMes, mes).tarifas
      );
      const max = Math.max(...serie.map((p) => p.neto), 1);
      const box = $('cd-serie');
      box.replaceChildren();
      for (const p of serie) {
        const fila = el('button', undefined, 'flex w-full items-center gap-3 rounded px-1 py-0.5 text-left text-xs hover:bg-slate-800/60');
        fila.type = 'button';
        if (p.mes === f.mes) fila.classList.add('bg-slate-800');
        fila.append(el('span', mesCorto(p.mes), 'w-14 shrink-0 text-slate-400'));
        const pista = el('span', undefined, 'h-2.5 flex-1 overflow-hidden rounded bg-slate-800');
        const barra = el('span', undefined, `block h-full rounded ${p.mes === f.mes ? 'bg-status-red' : 'bg-slate-600'}`);
        barra.style.width = `${Math.max(0, (p.neto / max) * 100)}%`;
        pista.append(barra);
        fila.append(pista);
        fila.append(el('span', p.bruto > 0 ? fmtMonto(p.neto) : p.casos > 0 ? 'sin tarifas' : '—', 'w-28 shrink-0 text-right tabular-nums text-slate-200'));
        fila.append(el('span', `${fmt(p.casos)} casos`, 'w-16 shrink-0 text-right tabular-nums text-slate-500'));
        fila.addEventListener('click', () => {
          mesSel.value = p.mes;
          mesSel.dispatchEvent(new Event('change'));
        });
        box.append(fila);
      }
    }

    function renderDatos(r: Resultado) {
      const items: string[] = [];
      const d = r.datos;
      if (d.sinMotivo > 0) items.push(`${fmt(d.sinMotivo)} casos sin motivo: en el ticket de soporte, elegir el Motivo (Calidad, Transporte, Post-Venta) — hoy casi ninguno lo tiene cargado.`);
      if (d.sinVincular > 0) items.push(`${fmt(d.sinVincular)} casos de transporte o post-venta sin nota de venta: vincular en el ticket la nota de venta que se le hizo al transportista o al cliente, así se resta lo facturado.`);
      if (d.sinHoras > 0) items.push(`${fmt(d.sinHoras)} reparaciones sin horas cargadas: la mano de obra de esos casos figura en $0.`);
      if (d.sinFlete > 0) items.push(`${fmt(d.sinFlete)} devoluciones sin flete: ni hay tarifa de su provincia ni el cliente tiene región con recargo.`);
      $('cd-datos-card').classList.toggle('hidden', items.length === 0);
      const ul = $('cd-datos');
      ul.replaceChildren();
      for (const i of items) ul.append(el('li', i));
    }

    function renderProvincias(r: Resultado) {
      const tbody = $('cd-tbody');
      const tfoot = $('cd-tfoot');
      tbody.replaceChildren();
      tfoot.replaceChildren();
      $('cd-vacio').classList.toggle('hidden', r.filas.length > 0);
      if (r.filas.length === 0) return;

      for (const x of r.filas) {
        const tr = el('tr', undefined, 'border-b border-slate-800/60 text-slate-300');
        tr.append(el('td', x.provincia, 'py-2 pr-4 whitespace-nowrap'));
        celda(tr, fmt(x.living), 'text-right');
        celda(tr, fmt(x.colchon), 'text-right');
        celda(tr, fmtPct(x.recargoPct), 'text-right');
        celda(tr, monto(x.flete), 'text-right');
        celda(tr, monto(x.manoObra), 'text-right');
        celda(tr, monto(x.material), 'text-right');
        celda(tr, monto(x.facturado), 'text-right');
        celda(tr, monto(x.neto), 'text-right font-medium text-slate-100');
        tr.append(el('td', monto(x.notaCredito), 'py-2 text-right tabular-nums whitespace-nowrap'));
        tbody.append(tr);
      }
      const t = r.totales;
      const pie = el('tr', undefined, 'font-medium text-slate-100');
      pie.append(el('td', 'Total', 'py-2 pr-4'));
      celda(pie, fmt(t.living), 'text-right');
      celda(pie, fmt(t.colchon), 'text-right');
      celda(pie, '', 'text-right');
      celda(pie, monto(t.flete), 'text-right');
      celda(pie, monto(t.manoObra), 'text-right');
      celda(pie, monto(t.material), 'text-right');
      celda(pie, monto(t.facturado), 'text-right');
      celda(pie, monto(t.neto), 'text-right');
      pie.append(el('td', monto(t.notaCredito), 'py-2 text-right tabular-nums whitespace-nowrap'));
      tfoot.append(pie);
    }

    const MAX_CASOS = 150;
    function renderCasos(r: Resultado) {
      const tbody = $('cd-casos');
      tbody.replaceChildren();
      for (const c of r.casos.slice(0, MAX_CASOS)) {
        const tr = el('tr', undefined, 'border-b border-slate-800/60 text-slate-300');
        const ref = el('td', undefined, 'py-2 pr-4 whitespace-nowrap');
        ref.append(el('span', c.ref));
        if (c.ticket) ref.append(el('span', ` · ${c.ticket.slice(0, 28)}`, 'text-xs text-slate-500'));
        tr.append(ref);
        tr.append(el('td', c.cliente, 'py-2 pr-4'));
        tr.append(el('td', c.provincia, 'py-2 pr-4 whitespace-nowrap'));
        tr.append(el('td', c.sector === 'living' ? 'Living' : 'Colchón', 'py-2 pr-4'));
        const motivo = el('td', CAUSA_LABEL[c.causa], 'py-2 pr-4 whitespace-nowrap');
        if (c.causa === 'sinmotivo') motivo.classList.add('text-status-yellow');
        motivo.title = c.motivo;
        tr.append(motivo);
        celda(tr, c.horas > 0 ? fmtHoras(c.horas) : '—', 'text-right');
        celda(tr, c.fuenteFlete === 'recargo' ? `~${fmtMonto(c.flete)}` : monto(c.flete), 'text-right');
        celda(tr, monto(c.manoObra), 'text-right');
        celda(tr, monto(c.material), 'text-right');
        celda(tr, monto(c.facturado), 'text-right');
        tr.append(el('td', fmtMonto(c.neto), 'py-2 text-right font-medium tabular-nums text-slate-100'));
        tbody.append(tr);
      }
      const mas = $('cd-casos-mas');
      mas.classList.toggle('hidden', r.casos.length <= MAX_CASOS);
      mas.textContent = `Se muestran los ${MAX_CASOS} de mayor costo, de ${fmt(r.casos.length)} casos. El PDF y los totales incluyen todos.`;
    }

    function actualizar() {
      const f = filtros();
      resultado = calcular(data, f, tarifas);
      renderHero(resultado, f);
      renderIndices(resultado, f);
      renderCausas(resultado);
      renderSerie();
      renderDatos(resultado);
      renderProvincias(resultado);
      renderCasos(resultado);
      $('cd-resumen').textContent = armarResumen(resultado, f);
      $('cd-tarifas-mes').textContent = mesLabel(f.mes);
      $('cd-tarifas-estado').textContent = dirty ? 'Cambios sin guardar' : origen;
    }

    const provincias = [...new Set(data.registros.map((r) => r.provincia))].sort((x, y) => x.localeCompare(y, 'es'));

    function armarFletes() {
      fletesBox.replaceChildren();
      for (const provincia of provincias) {
        const label = el('label', undefined, 'flex items-center justify-between gap-3 text-sm text-slate-400');
        label.append(el('span', provincia));
        const input = el(
          'input',
          undefined,
          'w-28 rounded border border-slate-700 bg-slate-950 px-2 py-1 text-right text-slate-200 focus:border-brand-500 focus:outline-none'
        );
        input.type = 'number';
        input.min = '0';
        input.step = 'any';
        input.inputMode = 'decimal';
        input.value = tarifas.fletes[provincia] ? String(tarifas.fletes[provincia]) : '';
        input.addEventListener('input', () => {
          tarifas.fletes[provincia] = positivo(Number(input.value));
          dirty = true;
          actualizar();
        });
        label.append(input);
        fletesBox.append(label);
      }
    }

    horaIn.addEventListener('input', () => {
      tarifas.costoHora = positivo(Number(horaIn.value));
      dirty = true;
      actualizar();
    });
    viajesIn.addEventListener('input', () => {
      tarifas.viajes = positivo(Number(viajesIn.value));
      dirty = true;
      actualizar();
    });

    $('cd-flete-aplicar').addEventListener('click', () => {
      const valor = positivo(Number(todasIn.value));
      // A todas las provincias con datos, no solo a las que muestran los filtros actuales.
      for (const provincia of provincias) tarifas.fletes[provincia] = valor;
      dirty = true;
      armarFletes();
      actualizar();
    });

    guardarBtn.addEventListener('click', async () => {
      guardarBtn.disabled = true;
      guardarMsg.textContent = 'Guardando…';
      try {
        const mes = mesSel.value;
        const res = await fetch('/api/costo-devoluciones-tarifas', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ mes, costoHora: tarifas.costoHora, viajes: tarifas.viajes, fletes: tarifas.fletes }),
        });
        const body = (await res.json()) as { ok: boolean; data?: TarifasGuardadas['porMes'][string]; error?: string };
        if (!body.ok || !body.data) throw new Error(body.error ?? 'No se pudo guardar');
        guardadas.porMes[mes] = body.data;
        dirty = false;
        origen = `Guardadas por ${body.data.actualizadoPor ?? '—'} el ${fechaLarga(body.data.updatedAt)}`;
        guardarMsg.textContent = `Tarifas de ${mesLabel(mes)} guardadas.`;
        actualizar();
      } catch (err) {
        guardarMsg.textContent = err instanceof Error ? err.message : 'No se pudo guardar';
      } finally {
        guardarBtn.disabled = !guardadas.disponible;
      }
    });

    pdfBtn.addEventListener('click', async () => {
      pdfBtn.disabled = true;
      try {
        // Carga diferida: jsPDF solo se baja cuando se pide el PDF.
        const { generarPdfCostoDevoluciones } = await import('./costo-devoluciones-pdf');
        const f = filtros();
        const empresa = f.empresa === 0 ? 'Todas' : (data.empresas.find((e) => e.id === f.empresa)?.name ?? '—');
        const doc = generarPdfCostoDevoluciones(resultado, f, tarifas, empresa);
        const sufijo = [f.sector !== 'todos' ? SECTOR_LABEL[f.sector].toLowerCase() : '', f.empresa !== 0 ? empresa.toLowerCase().replace(/[^a-z0-9]+/g, '-') : '']
          .filter(Boolean)
          .join('-');
        doc.save(`costo-no-calidad-${f.mes}${sufijo ? `-${sufijo}` : ''}.pdf`);
      } finally {
        pdfBtn.disabled = false;
      }
    });

    mesSel.addEventListener('change', () => {
      cargarTarifasDelMes();
      armarFletes();
      actualizar();
    });
    sectorSel.addEventListener('change', actualizar);
    empresaSel.addEventListener('change', actualizar);

    cargarTarifasDelMes();
    armarFletes();
    actualizar();
  }
</script>
