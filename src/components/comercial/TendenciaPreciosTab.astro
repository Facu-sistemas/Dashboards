---
import ProductPriceTrendApp from './ProductPriceTrendApp';
import { buildProductListDehydratedState } from '../../lib/product-price-trend-ssr';

let dehydratedState;
let ssrError: string | null = null;
try {
  dehydratedState = await buildProductListDehydratedState();
} catch (err) {
  ssrError = err instanceof Error ? err.message : 'Error desconocido consultando Odoo';
}
---

<div>
  <header class="mb-6">
    <h2 class="text-lg font-semibold text-slate-100">Tendencia de Precios</h2>
    <p class="mt-1 text-sm text-slate-400">
      Evolución mensual del precio de un producto vendible: precio de lista cuando cambió ese mes,
      o el promedio de lo cotizado ese mes (subtotal de la línea del producto en todas las
      cotizaciones no canceladas, sin recargos) si no hubo cambio de lista, o el último valor
      conocido cuando el mes no tuvo novedades. La banda sombreada muestra el rango entre la
      cotización más baja y más alta de cada mes. Datos en vivo desde Odoo — solo lectura.
    </p>
  </header>

  {
    ssrError && (
      <p class="mb-6 rounded border border-red-900 bg-red-950/50 p-3 text-sm text-red-300">
        No se pudo precargar la data desde Odoo en el servidor ({ssrError}). El panel
        intentará cargar los datos desde el navegador.
      </p>
    )
  }

  <ProductPriceTrendApp client:load dehydratedState={dehydratedState} />
</div>
