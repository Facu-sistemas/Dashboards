---
import ClientesActivosApp from './ClientesActivosApp';
import { buildClientesActivosDehydratedState } from '../../lib/clientes-activos-ssr';
import type { ClientesActivosPeriodo } from '../../lib/odoo/clientes-activos';

const PERIODO_VALUES: ClientesActivosPeriodo[] = ['30d', '3m', '6m', '9m'];

const params = Astro.url.searchParams;
const periodoParam = params.get('periodo');
const initialPeriodo: ClientesActivosPeriodo = PERIODO_VALUES.includes(periodoParam as ClientesActivosPeriodo)
  ? (periodoParam as ClientesActivosPeriodo)
  : '30d';

let dehydratedState;
let ssrError: string | null = null;
try {
  dehydratedState = await buildClientesActivosDehydratedState(initialPeriodo);
} catch (err) {
  ssrError = err instanceof Error ? err.message : 'Error desconocido consultando Odoo';
}
---

<div>
  <header class="mb-6">
    <h2 class="text-lg font-semibold text-slate-100">Clientes Activos</h2>
    <p class="mt-1 text-sm text-slate-400">
      Clientes con al menos la cantidad indicada en "Condición" (pedidos confirmados o facturas,
      según la Fuente elegida) dentro del período seleccionado, con el Top 10 ordenable. Solo
      lectura.
    </p>
  </header>

  {
    ssrError && (
      <p class="mb-6 rounded border border-red-900 bg-red-950/50 p-3 text-sm text-red-300">
        No se pudo precargar la data desde Odoo en el servidor ({ssrError}). El panel intentará cargar
        los datos desde el navegador.
      </p>
    )
  }

  <ClientesActivosApp client:load initialPeriodo={initialPeriodo} dehydratedState={dehydratedState} />
</div>
