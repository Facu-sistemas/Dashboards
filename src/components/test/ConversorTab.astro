---
import ConversorExcelCsv from './ConversorExcelCsv';
import MarkdownAPdf from './MarkdownAPdf';
import CopiadoRapido from './CopiadoRapido';
---

<div>
  <header class="mb-6">
    <h2 class="text-lg font-semibold text-slate-100">Conversor Excel / CSV</h2>
    <p class="mt-1 text-sm text-slate-400">
      Convertí archivos entre Excel y CSV. Todo se procesa en tu navegador, no se sube nada a ningún servidor.
    </p>
  </header>

  <ConversorExcelCsv client:only="react" />

  <hr class="my-8 border-slate-800" />

  <header class="mb-6">
    <h2 class="text-lg font-semibold text-slate-100">Copiado rápido</h2>
    <p class="mt-1 text-sm text-slate-400">
      Guardá los pedacitos de texto que usás siempre y copialos al portapapeles con un clic.
    </p>
  </header>

  <CopiadoRapido client:only="react" />

  <hr class="my-8 border-slate-800" />

  <header class="mb-6">
    <h2 class="text-lg font-semibold text-slate-100">Markdown a PDF</h2>
    <p class="mt-1 text-sm text-slate-400">
      Pegá texto en Markdown y descargalo como PDF, listo para compartir.
    </p>
  </header>

  <MarkdownAPdf client:only="react" />
</div>
