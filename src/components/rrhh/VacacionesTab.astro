---
import VacacionesApp from './VacacionesApp';
import { buildRrhhVacacionesDehydratedState } from '../../lib/rrhh-vacaciones-ssr';

let dehydratedState;
let ssrError: string | null = null;
try {
  dehydratedState = await buildRrhhVacacionesDehydratedState();
} catch (err) {
  ssrError = err instanceof Error ? err.message : 'Error desconocido consultando Odoo';
}
---

<div>
  <header class="mb-6">
    <h2 class="text-lg font-semibold text-slate-100">Vacaciones</h2>
    <p class="mt-1 text-sm text-slate-400">
      Saldo de vacaciones (días asignados menos días tomados, ambos validados en Odoo) de cada
      empleado activo, para detectar casos como saldo negativo que RRHH tiene que corregir a mano.
      Incluye resumen de contrato y horas cargadas. Solo lectura.
    </p>
  </header>

  {
    ssrError && (
      <p class="mb-6 rounded border border-red-900 bg-red-950/50 p-3 text-sm text-red-300">
        No se pudo precargar la data desde Odoo en el servidor ({ssrError}). El panel intentará cargar
        los datos desde el navegador.
      </p>
    )
  }

  <VacacionesApp client:load dehydratedState={dehydratedState} />
</div>
