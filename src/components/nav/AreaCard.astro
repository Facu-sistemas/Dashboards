---
import { ACCENT_CLASSES, type AreaConfig } from '@/lib/areas.config';

interface Props {
  area: AreaConfig;
  /** Posición en la grilla, para escalonar la animación de entrada. */
  index?: number;
}

const { area, index = 0 } = Astro.props;
const accent = ACCENT_CLASSES[area.accent];
const href = `/${area.slug}/${area.tabs[0]!.slug}`;
---

<!-- El color de acento viaja por currentColor: el filo de luz del borde lo toma de ahí. -->
<a
  href={href}
  class={`area-card group relative flex flex-col gap-3 rounded-xl border border-slate-800 bg-slate-900 p-5 shadow-sm ${accent.text}`}
  style={`--i:${index}`}
>
  <span class={`area-card__icon flex h-11 w-11 items-center justify-center rounded-xl ${accent.bg}`}>
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" class="h-6 w-6" set:html={area.icon} />
  </span>
  <span class="area-card__text text-base font-semibold text-slate-100">{area.name}</span>
  <span class="area-card__text text-sm text-slate-500">{area.description}</span>

  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="area-card__arrow" aria-hidden="true">
    <path d="M5 12h14M13 6l6 6-6 6"></path>
  </svg>
</a>

<style>
  .area-card {
    --mx: 50%;
    --my: 50%;
    transform-style: preserve-3d;
    transform: perspective(900px);
    animation: area-card-in 0.5s cubic-bezier(0.22, 1, 0.36, 1) backwards;
    animation-delay: calc(var(--i) * 60ms);
  }

  /* Filo de luz: sólo el borde de 1px se ilumina, siguiendo al cursor. */
  .area-card::before {
    content: '';
    position: absolute;
    inset: -1px;
    padding: 1px;
    border-radius: inherit;
    background: radial-gradient(220px circle at var(--mx) var(--my), currentColor, transparent 65%);
    -webkit-mask:
      linear-gradient(#000 0 0) content-box,
      linear-gradient(#000 0 0);
    -webkit-mask-composite: xor;
    mask:
      linear-gradient(#000 0 0) content-box exclude,
      linear-gradient(#000 0 0);
    opacity: 0;
    transition: opacity 0.4s;
    pointer-events: none;
  }
  .area-card:hover::before,
  .area-card:focus-visible::before {
    opacity: 1;
  }

  /* Profundidad: el contenido flota apenas por encima de la card. */
  .area-card__icon {
    transform: translateZ(0);
    transition: transform 0.35s cubic-bezier(0.22, 1, 0.36, 1);
  }
  .area-card:hover .area-card__icon {
    transform: translateZ(28px);
  }
  .area-card__text {
    transform: translateZ(0);
    transition:
      transform 0.35s cubic-bezier(0.22, 1, 0.36, 1),
      color 0.3s;
  }
  .area-card:hover .area-card__text {
    transform: translateZ(14px);
  }

  .area-card__arrow {
    position: absolute;
    right: 1.25rem;
    bottom: 1.25rem;
    width: 1.1rem;
    height: 1.1rem;
    opacity: 0;
    transform: translateX(-8px);
    transition:
      opacity 0.3s,
      transform 0.3s cubic-bezier(0.22, 1, 0.36, 1);
  }
  .area-card:hover .area-card__arrow,
  .area-card:focus-visible .area-card__arrow {
    opacity: 1;
    transform: translateX(0);
  }

  @keyframes area-card-in {
    from {
      opacity: 0;
      transform: perspective(900px) translateY(14px) scale(0.97);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .area-card {
      animation: none;
      transform: none;
    }
    .area-card__icon,
    .area-card__text {
      transform: none !important;
    }
  }
</style>

<script>
  // El filo de luz del borde sigue al cursor.
  document.querySelectorAll<HTMLElement>('.area-card').forEach((card) => {
    card.addEventListener('pointermove', (e) => {
      const r = card.getBoundingClientRect();
      card.style.setProperty('--mx', `${e.clientX - r.left}px`);
      card.style.setProperty('--my', `${e.clientY - r.top}px`);
    });
  });
</script>
