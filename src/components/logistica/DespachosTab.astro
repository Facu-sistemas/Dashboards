---
import { getDespachosData } from '@/lib/odoo/despachos';
import type { DespachoEstado, DespachosData } from '@/lib/odoo/despachos';
import { getPedidosSinDespacharData } from '@/lib/odoo/pedidos-sin-despachar';
import type { EntregaEstado, PedidosSinDespacharData } from '@/lib/odoo/pedidos-sin-despachar';

let desp: DespachosData | null = null;
let ped: PedidosSinDespacharData | null = null;
let ssrError: string | null = null;
try {
  [desp, ped] = await Promise.all([getDespachosData(), getPedidosSinDespacharData()]);
} catch (err) {
  ssrError = err instanceof Error ? err.message : 'Error desconocido consultando Odoo';
}

const ESTADO_LABEL: Record<DespachoEstado, string> = {
  assigned: 'Listo para despachar',
  confirmed: 'Esperando disponibilidad',
  waiting: 'Esperando otra operación',
};
const ESTADO_CLASS: Record<DespachoEstado, string> = {
  assigned: 'text-status-green',
  confirmed: 'text-status-yellow',
  waiting: 'text-slate-400',
};
/** Orden al ordenar por Estado: primero lo que ya se puede despachar. */
const ESTADO_ORDEN: Record<DespachoEstado, number> = { assigned: 0, confirmed: 1, waiting: 2 };

const ENTREGA_LABEL: Record<EntregaEstado, string> = {
  pending: 'Sin entregar',
  started: 'Iniciada',
  partial: 'Parcialmente entregado',
};
const ENTREGA_CLASS: Record<EntregaEstado, string> = {
  pending: 'text-status-yellow',
  started: 'text-slate-300',
  partial: 'text-brand-400',
};
const ENTREGA_ORDEN: Record<EntregaEstado, number> = { pending: 0, started: 1, partial: 2 };

const fmt = (n: number) => n.toLocaleString('es-AR');
const fmtMonto = (n: number) => n.toLocaleString('es-AR', { style: 'currency', currency: 'ARS', maximumFractionDigits: 0 });
const fmtFecha = (iso: string) => iso.split('-').reverse().join('/');

const maxAnt = desp ? Math.max(1, ...desp.antiguedad.map((b) => b.count)) : 1;
const maxEspera = ped ? Math.max(1, ...ped.espera.map((b) => b.count)) : 1;

const searchClass =
  'w-full rounded border border-slate-700 bg-slate-950 px-3 py-1.5 text-sm text-slate-200 placeholder:text-slate-500 focus:border-brand-500 focus:outline-none sm:w-80';
---

<div>
  <header class="mb-6">
    <h2 class="text-lg font-semibold text-slate-100">Pendientes de despacho</h2>
    <p class="mt-1 text-sm text-slate-400">
      Todo lo que está esperando salir, visto como remitos de salida (operación de depósito, todos los almacenes)
      o como pedidos de venta confirmados (con los días desde la confirmación). Para lo ya despachado, ver
      "Cumplimiento de entrega". Solo lectura.
    </p>
  </header>

  {
    ssrError && (
      <p class="mb-6 rounded border border-red-900 bg-red-950/50 p-3 text-sm text-red-300">
        No se pudo consultar Odoo ({ssrError}).
      </p>
    )
  }

  {
    desp && ped && (
      <>
        <section class="mb-6 grid grid-cols-2 gap-3 lg:grid-cols-5">
          <div class="rounded-lg border border-slate-800 bg-slate-900 p-4">
            <p class="text-xs text-slate-400">Remitos pendientes</p>
            <p class="mt-1 text-2xl font-semibold text-slate-100">{fmt(desp.pendientes.length)}</p>
          </div>
          <div class="rounded-lg border border-slate-800 bg-slate-900 p-4">
            <p class="text-xs text-slate-400">Listos para despachar</p>
            <p class="mt-1 text-2xl font-semibold text-status-green">{fmt(desp.porEstado.assigned)}</p>
          </div>
          <div class="rounded-lg border border-slate-800 bg-slate-900 p-4">
            <p class="text-xs text-slate-400">Esperando stock u otra operación</p>
            <p class="mt-1 text-2xl font-semibold text-status-yellow">
              {fmt(desp.porEstado.confirmed + desp.porEstado.waiting)}
            </p>
          </div>
          <div class="rounded-lg border border-slate-800 bg-slate-900 p-4">
            <p class="text-xs text-slate-400">Remitos atrasados</p>
            <p class="mt-1 text-2xl font-semibold text-status-red">{fmt(desp.atrasados)}</p>
          </div>
          <div class="rounded-lg border border-slate-800 bg-slate-900 p-4">
            <p class="text-xs text-slate-400">Pedidos sin despachar</p>
            <p class="mt-1 text-2xl font-semibold text-slate-100">{fmt(ped.pedidos.length)}</p>
            <p class="mt-0.5 text-xs text-slate-500">
              {fmtMonto(ped.montoTotal)} · espera máx. {fmt(ped.esperaMaxima)} d
            </p>
          </div>
        </section>

        <div class="mb-4 inline-flex rounded-lg border border-slate-800 bg-slate-900 p-1 text-sm" role="tablist">
          <button type="button" data-vista="remitos" class="vista-btn rounded px-3 py-1.5 font-medium">
            Por remito
          </button>
          <button type="button" data-vista="pedidos" class="vista-btn rounded px-3 py-1.5 font-medium">
            Por pedido
          </button>
        </div>

        <div data-panel="remitos">
          <section class="mb-6 rounded-lg border border-slate-800 bg-slate-900 p-4">
            <h3 class="mb-3 text-sm font-medium text-slate-200">Antigüedad de remitos pendientes <span class="font-normal text-slate-500">(respecto de la fecha programada)</span></h3>
            <ul class="space-y-2">
              {desp.antiguedad.map((b) => (
                <li class="flex items-center gap-3 text-sm">
                  <span class="w-36 shrink-0 text-slate-400">{b.label}</span>
                  <div class="h-3 flex-1 rounded bg-slate-800">
                    <div class="h-3 rounded bg-brand-500" style={`width:${(b.count / maxAnt) * 100}%`} />
                  </div>
                  <span class="w-12 text-right tabular-nums text-slate-200">{fmt(b.count)}</span>
                </li>
              ))}
            </ul>
          </section>

          <section class="rounded-lg border border-slate-800 bg-slate-900 p-4">
            <div class="mb-3 flex flex-wrap items-center justify-between gap-3">
              <h3 class="text-sm font-medium text-slate-200">
                Remitos pendientes
                <span id="desp-count" class="font-normal text-slate-500">({fmt(desp.pendientes.length)})</span>
              </h3>
              <input id="desp-search" type="search" placeholder="Buscar por cliente o remito…" class={searchClass} />
            </div>
            <div class="overflow-x-auto">
              <table id="desp-table" class="w-full text-left text-sm">
                <thead class="text-xs text-slate-400">
                  <tr class="border-b border-slate-800">
                    <th class="py-2 pr-4 font-medium"><button type="button" data-sort="remito" class="hover:text-slate-200">Remito</button></th>
                    <th class="py-2 pr-4 font-medium"><button type="button" data-sort="cliente" class="hover:text-slate-200">Cliente</button></th>
                    <th class="py-2 pr-4 font-medium"><button type="button" data-sort="origen" class="hover:text-slate-200">Origen</button></th>
                    <th class="py-2 pr-4 font-medium"><button type="button" data-sort="almacen" class="hover:text-slate-200">Almacén</button></th>
                    <th class="py-2 pr-4 font-medium"><button type="button" data-sort="estado" class="hover:text-slate-200">Estado</button></th>
                    <th class="py-2 pr-4 font-medium"><button type="button" data-sort="fecha" class="hover:text-slate-200">Programado</button></th>
                    <th class="py-2 text-right font-medium"><button type="button" data-sort="atraso" class="hover:text-slate-200">Días de atraso</button></th>
                  </tr>
                </thead>
                <tbody>
                  {desp.pendientes.map((p) => (
                    <tr
                      class="border-b border-slate-800/60 text-slate-300"
                      data-remito={p.name}
                      data-cliente={p.cliente}
                      data-origen={p.origen}
                      data-almacen={p.almacen}
                      data-estado={ESTADO_ORDEN[p.estado]}
                      data-fecha={p.fechaProgramada}
                      data-atraso={p.diasAtraso}
                    >
                      <td class="py-2 pr-4 whitespace-nowrap">{p.name}</td>
                      <td class="py-2 pr-4">{p.cliente}</td>
                      <td class="py-2 pr-4 whitespace-nowrap">{p.origen}</td>
                      <td class="py-2 pr-4 whitespace-nowrap">{p.almacen}</td>
                      <td class={`py-2 pr-4 whitespace-nowrap ${ESTADO_CLASS[p.estado]}`}>{ESTADO_LABEL[p.estado]}</td>
                      <td class="py-2 pr-4 whitespace-nowrap">{fmtFecha(p.fechaProgramada)}</td>
                      <td class="py-2 text-right tabular-nums">{fmt(p.diasAtraso)}</td>
                    </tr>
                  ))}
                </tbody>
              </table>
              <p id="desp-empty" class="hidden py-6 text-center text-sm text-slate-500">Ningún remito coincide con la búsqueda.</p>
            </div>
          </section>
        </div>

        <div data-panel="pedidos" hidden>
          <section class="mb-6 rounded-lg border border-slate-800 bg-slate-900 p-4">
            <h3 class="mb-3 text-sm font-medium text-slate-200">
              Antigüedad de pedidos pendientes <span class="font-normal text-slate-500">(desde la confirmación · espera promedio {ped.esperaPromedio.toLocaleString('es-AR', { maximumFractionDigits: 0 })} días)</span>
            </h3>
            <ul class="space-y-2">
              {ped.espera.map((b) => (
                <li class="flex items-center gap-3 text-sm">
                  <span class="w-32 shrink-0 text-slate-400">{b.label}</span>
                  <div class="h-3 flex-1 rounded bg-slate-800">
                    <div class="h-3 rounded bg-brand-500" style={`width:${(b.count / maxEspera) * 100}%`} />
                  </div>
                  <span class="w-12 text-right tabular-nums text-slate-200">{fmt(b.count)}</span>
                  <span class="hidden w-40 text-right tabular-nums text-slate-400 sm:inline">{fmtMonto(b.monto)}</span>
                </li>
              ))}
            </ul>
          </section>

          <section class="rounded-lg border border-slate-800 bg-slate-900 p-4">
            <div class="mb-3 flex flex-wrap items-center justify-between gap-3">
              <h3 class="text-sm font-medium text-slate-200">
                Pedidos <span id="ped-count" class="font-normal text-slate-500">({fmt(ped.pedidos.length)})</span>
                <span class="font-normal text-slate-500"> · monto = total del pedido con IVA</span>
              </h3>
              <input id="ped-search" type="search" placeholder="Buscar por cliente, pedido o vendedor…" class={searchClass} />
            </div>
            <div class="overflow-x-auto">
              <table id="ped-table" class="w-full text-left text-sm">
                <thead class="text-xs text-slate-400">
                  <tr class="border-b border-slate-800">
                    <th class="py-2 pr-4 font-medium"><button type="button" data-sort="pedido" class="hover:text-slate-200">Pedido</button></th>
                    <th class="py-2 pr-4 font-medium"><button type="button" data-sort="cliente" class="hover:text-slate-200">Cliente</button></th>
                    <th class="py-2 pr-4 font-medium"><button type="button" data-sort="vendedor" class="hover:text-slate-200">Vendedor</button></th>
                    <th class="py-2 pr-4 font-medium"><button type="button" data-sort="estado" class="hover:text-slate-200">Entrega</button></th>
                    <th class="py-2 pr-4 font-medium"><button type="button" data-sort="fecha" class="hover:text-slate-200">Confirmado</button></th>
                    <th class="py-2 pr-4 text-right font-medium"><button type="button" data-sort="dias" class="hover:text-slate-200">Días de espera</button></th>
                    <th class="py-2 text-right font-medium"><button type="button" data-sort="monto" class="hover:text-slate-200">Monto</button></th>
                  </tr>
                </thead>
                <tbody>
                  {ped.pedidos.map((p) => (
                    <tr
                      class="border-b border-slate-800/60 text-slate-300"
                      data-pedido={p.name}
                      data-cliente={p.cliente}
                      data-vendedor={p.vendedor}
                      data-estado={ENTREGA_ORDEN[p.estado]}
                      data-fecha={p.fecha}
                      data-dias={p.diasEspera}
                      data-monto={p.monto}
                    >
                      <td class="py-2 pr-4 whitespace-nowrap">{p.name}</td>
                      <td class="py-2 pr-4">{p.cliente}</td>
                      <td class="py-2 pr-4 whitespace-nowrap">{p.vendedor}</td>
                      <td class={`py-2 pr-4 whitespace-nowrap ${ENTREGA_CLASS[p.estado]}`}>{ENTREGA_LABEL[p.estado]}</td>
                      <td class="py-2 pr-4 whitespace-nowrap">{fmtFecha(p.fecha)}</td>
                      <td class="py-2 pr-4 text-right tabular-nums">{fmt(p.diasEspera)}</td>
                      <td class="py-2 text-right tabular-nums whitespace-nowrap">{fmtMonto(p.monto)}</td>
                    </tr>
                  ))}
                </tbody>
              </table>
              <p id="ped-empty" class="hidden py-6 text-center text-sm text-slate-500">Ningún pedido coincide con la búsqueda.</p>
            </div>
          </section>
        </div>
      </>
    )
  }
</div>

<script>
  import { initSortableTable } from './sortable-table';

  initSortableTable({
    prefix: 'desp',
    searchKeys: ['cliente', 'remito'],
    numericKeys: ['estado', 'atraso'],
    defaultSort: 'fecha',
    descFirst: ['atraso'],
    tieBreaker: 'atraso',
  });
  initSortableTable({
    prefix: 'ped',
    searchKeys: ['cliente', 'pedido', 'vendedor'],
    numericKeys: ['estado', 'dias', 'monto'],
    defaultSort: 'dias',
    descFirst: ['dias', 'monto'],
  });

  const botones = document.querySelectorAll<HTMLButtonElement>('.vista-btn');
  const paneles = document.querySelectorAll<HTMLElement>('[data-panel]');
  function mostrar(vista: string) {
    paneles.forEach((p) => {
      p.hidden = p.dataset.panel !== vista;
    });
    botones.forEach((b) => {
      const activo = b.dataset.vista === vista;
      b.classList.toggle('bg-brand-500', activo);
      b.classList.toggle('text-white', activo);
      b.classList.toggle('text-slate-400', !activo);
      b.setAttribute('aria-selected', String(activo));
    });
  }
  botones.forEach((b) => b.addEventListener('click', () => mostrar(b.dataset.vista ?? 'remitos')));
  mostrar('remitos');
</script>

<style>
  button[data-sort]::after {
    content: attr(data-arrow);
  }
</style>
