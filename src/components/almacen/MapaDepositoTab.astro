---
import AlmacenApp from './AlmacenApp';
import { buildAlmacenLayoutDehydratedState } from '../../lib/almacen-ssr';

let dehydratedState;
let ssrError: string | null = null;
try {
  dehydratedState = await buildAlmacenLayoutDehydratedState();
} catch (err) {
  ssrError = err instanceof Error ? err.message : 'Error desconocido consultando Odoo';
}
---

<div>
  <header class="mb-6">
    <h2 class="text-lg font-semibold text-slate-100">Mapa de Depósito</h2>
    <p class="mt-1 text-sm text-slate-400">
      Layout físico de racks, pasillos y oficina. Click en un rack para ver su detalle
      (columna.nivel) y elegir una ubicación puntual, o en Almacén 2 para ver su stock directo —
      todo en tiempo real desde Odoo. Solo lectura.
    </p>
  </header>

  {
    ssrError && (
      <p class="mb-6 rounded border border-red-900 bg-red-950/50 p-3 text-sm text-red-300">
        No se pudo precargar la data desde Odoo en el servidor ({ssrError}). El panel
        intentará cargar los datos desde el navegador.
      </p>
    )
  }

  <AlmacenApp client:load dehydratedState={dehydratedState} />
</div>
