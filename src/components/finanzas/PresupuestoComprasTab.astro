---
import DashboardApp from '../dashboard/DashboardApp';
import { buildDehydratedState } from '../../lib/dashboard-ssr';
import { currentMonthKey } from '../../lib/date';
import type { DashboardFilters } from '../dashboard/types';

const params = Astro.url.searchParams;
const monthParam = params.get('month');
const initialFilters: DashboardFilters = {
  month: monthParam && /^\d{4}-\d{2}$/.test(monthParam) ? monthParam : currentMonthKey(),
  categoryId: params.get('category_id') ? Number(params.get('category_id')) : undefined,
};

let dehydratedState;
let ssrError: string | null = null;
try {
  dehydratedState = await buildDehydratedState(initialFilters);
} catch (err) {
  ssrError = err instanceof Error ? err.message : 'Error desconocido consultando Odoo';
}
---

<div>
  <header class="mb-6">
    <h2 class="text-lg font-semibold text-slate-100">% Cumplimiento del Presupuesto de Compras</h2>
    <p class="mt-1 text-sm text-slate-400">
      Datos en vivo desde Odoo (solo lectura). Presupuestado vs. real por categoría, cada una en
      su moneda de carga — sin conversión entre pesos y dólares.
    </p>
  </header>

  {
    ssrError && (
      <p class="mb-6 rounded border border-red-900 bg-red-950/50 p-3 text-sm text-red-300">
        No se pudo precargar la data desde Odoo en el servidor ({ssrError}). El panel
        intentará cargar los datos desde el navegador.
      </p>
    )
  }

  <DashboardApp client:load initialFilters={initialFilters} dehydratedState={dehydratedState} />
</div>
