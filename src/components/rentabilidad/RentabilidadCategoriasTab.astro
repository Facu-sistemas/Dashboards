---
import RentabilidadCategoriasApp from './RentabilidadCategoriasApp';
import { getArgentinaTodayIso } from '@/lib/odoo/oee';

const initialAnio = Number(getArgentinaTodayIso().slice(0, 4));
---

<div>
  <header class="mb-6">
    <h2 class="text-lg font-semibold text-slate-100">Categorías</h2>
    <p class="mt-1 text-sm text-slate-400">
      Ventas y contribución por categoría y subcategoría de producto. Elegí una categoría o subcategoría para ver sus productos y la evolución mensual de
      cada uno. Solo lectura.
    </p>
  </header>

  <RentabilidadCategoriasApp client:load initialAnio={initialAnio} />
</div>
