---
import ClientesActivosApp from './ClientesActivosApp';
import { buildClientesActivosDehydratedState } from '../../lib/clientes-activos-ssr';
import type { ClientesActivosMeses } from '../../lib/odoo/clientes-activos';

const MESES_VALUES: ClientesActivosMeses[] = [3, 6, 9];

const params = Astro.url.searchParams;
const mesesParam = Number(params.get('meses'));
const initialMeses: ClientesActivosMeses = MESES_VALUES.includes(mesesParam as ClientesActivosMeses)
  ? (mesesParam as ClientesActivosMeses)
  : 3;

let dehydratedState;
let ssrError: string | null = null;
try {
  dehydratedState = await buildClientesActivosDehydratedState(initialMeses);
} catch (err) {
  ssrError = err instanceof Error ? err.message : 'Error desconocido consultando Odoo';
}
---

<div>
  <header class="mb-6">
    <h2 class="text-lg font-semibold text-slate-100">Clientes Activos</h2>
    <p class="mt-1 text-sm text-slate-400">
      Clientes con al menos la cantidad de facturas posteadas indicada en "Condición" dentro del
      período seleccionado, con el Top 10 ordenable y alerta de notas de crédito asociadas. Solo
      lectura.
    </p>
  </header>

  {
    ssrError && (
      <p class="mb-6 rounded border border-red-900 bg-red-950/50 p-3 text-sm text-red-300">
        No se pudo precargar la data desde Odoo en el servidor ({ssrError}). El panel intentará cargar
        los datos desde el navegador.
      </p>
    )
  }

  <ClientesActivosApp client:load initialMeses={initialMeses} dehydratedState={dehydratedState} />
</div>
