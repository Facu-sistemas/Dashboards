---
import OeeApp from './OeeApp';
import { buildOeeDehydratedState } from '../../lib/oee-ssr';
import { getArgentinaTodayIso, type OeePeriodKind } from '../../lib/odoo/oee';

const PERIOD_VALUES: OeePeriodKind[] = ['day', 'week', 'month'];
const DATE_RE = /^\d{4}-\d{2}-\d{2}$/;

const params = Astro.url.searchParams;
const periodParam = params.get('period');
const dateParam = params.get('date');
const initialPeriodKind: OeePeriodKind = PERIOD_VALUES.includes(periodParam as OeePeriodKind)
  ? (periodParam as OeePeriodKind)
  : 'day';
const initialDate = dateParam && DATE_RE.test(dateParam) ? dateParam : getArgentinaTodayIso();

let dehydratedState;
let ssrError: string | null = null;
try {
  dehydratedState = await buildOeeDehydratedState(initialPeriodKind, initialDate);
} catch (err) {
  ssrError = err instanceof Error ? err.message : 'Error desconocido consultando Odoo';
}
---

<div>
  <header class="mb-6">
    <h2 class="text-lg font-semibold text-slate-100">Eficiencia de Producción</h2>
    <p class="mt-1 text-sm text-slate-400">
      Planificado vs. cumplido por familia de producto — usa los mismos filtros que Planificación
      aplica en Odoo (Fabricación: "CERRADO COLCHONES/LIVING", "PLAN+CUMPL COLC/LIVING"). No
      incluye desglose de Disponibilidad × Rendimiento × Calidad — Odoo no tiene cargados datos de
      paradas de máquina todavía. Solo lectura.
    </p>
  </header>

  {
    ssrError && (
      <p class="mb-6 rounded border border-red-900 bg-red-950/50 p-3 text-sm text-red-300">
        No se pudo precargar la data desde Odoo en el servidor ({ssrError}). El panel
        intentará cargar los datos desde el navegador.
      </p>
    )
  }

  <OeeApp client:load initialPeriodKind={initialPeriodKind} initialDate={initialDate} dehydratedState={dehydratedState} />
</div>
