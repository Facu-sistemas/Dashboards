---
import TopProductsApp from './TopProductsApp';
import { buildTopProductsDehydratedState } from '../../lib/top-products-ssr';
import type { TopProductsRange } from '../../lib/odoo/top-products';

const RANGE_VALUES: TopProductsRange[] = ['all', 'this-year', 'last-12-months', 'last-6-months'];

const params = Astro.url.searchParams;
const rangeParam = params.get('range');
const initialRange: TopProductsRange = RANGE_VALUES.includes(rangeParam as TopProductsRange)
  ? (rangeParam as TopProductsRange)
  : 'all';

let dehydratedState;
let ssrError: string | null = null;
try {
  dehydratedState = await buildTopProductsDehydratedState(initialRange);
} catch (err) {
  ssrError = err instanceof Error ? err.message : 'Error desconocido consultando Odoo';
}
---

<div>
  <header class="mb-6">
    <h2 class="text-lg font-semibold text-slate-100">Top 10 Productos por Unidades</h2>
    <p class="mt-1 text-sm text-slate-400">
      Ranking de unidades vendidas (ventas confirmadas) por producto, separado en Colchones y
      Living. Solo lectura.
    </p>
  </header>

  {
    ssrError && (
      <p class="mb-6 rounded border border-red-900 bg-red-950/50 p-3 text-sm text-red-300">
        No se pudo precargar la data desde Odoo en el servidor ({ssrError}). El panel
        intentará cargar los datos desde el navegador.
      </p>
    )
  }

  <TopProductsApp client:load initialRange={initialRange} dehydratedState={dehydratedState} />
</div>
