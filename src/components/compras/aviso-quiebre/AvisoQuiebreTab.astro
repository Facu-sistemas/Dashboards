---
import './aviso-quiebre.css';
---

<div>
  <header class="mb-6">
    <h2 class="text-lg font-semibold text-slate-100">Aviso de quiebre de insumos</h2>
    <p class="mt-1 text-sm text-slate-400">
      Insumos de materia prima que pueden quedarse sin stock, por nivel de urgencia, con el stock y las órdenes de compra de Odoo en vivo. Solo lectura.
    </p>
  </header>

  <div id="avq-root" class="avq"><p class="text-sm text-slate-400">Cargando…</p></div>
</div>

<script>
  import { montarAvisoQuiebre } from './montar';

  const root = document.getElementById('avq-root');

  async function cargar(forzar: boolean) {
    const r = await fetch(forzar ? '/api/aviso-quiebre?forzar=1' : '/api/aviso-quiebre', { credentials: 'same-origin' });
    const j = await r.json();
    if (!j.ok) throw new Error(j.error || 'Error');
    const d = j.data;
    montarAvisoQuiebre(root, d.estado, {
      vivo: d.vivo,
      vistos: d.vistos,
      vistosDisponibles: d.vistosDisponibles,
      yo: d.yo,
      puedeEditar: d.puedeEditar,
      sincronizar: () => cargar(true),
      publicar: async (st: unknown) => {
        const r2 = await fetch('/api/aviso-quiebre', { method: 'POST', credentials: 'same-origin', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify(st) });
        const jj = await r2.json().catch(() => ({}));
        if (!r2.ok || !jj.ok) throw new Error(jj.error || 'No se pudo publicar');
      },
    });
  }

  if (root) {
    cargar(false).catch(() => {
      root.innerHTML = '<p class="text-sm text-red-400">No se pudo cargar el aviso. Probá de nuevo.</p>';
    });
  }
</script>
