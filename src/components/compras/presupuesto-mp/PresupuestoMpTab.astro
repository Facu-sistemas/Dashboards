---
import './presupuesto-mp.css';
---

<div>
  <header class="mb-6">
    <h2 class="text-lg font-semibold text-slate-100">Presupuesto y cumplimiento MP</h2>
    <p class="mt-1 text-sm text-slate-400">
      Rendición de cuentas de Compras de materias primas: presupuesto aprobado, cumplimiento de los meses cerrados e inventario. Solo lectura.
    </p>
  </header>

  <div id="pmp-root" class="pmp"><p class="text-sm text-slate-400">Cargando…</p></div>
</div>

<script>
  import { montarPresupuestoMp } from './montar';

  const root = document.getElementById('pmp-root');

  async function cargar(forzar: boolean) {
    const r = await fetch(forzar ? '/api/presupuesto-mp?forzar=1' : '/api/presupuesto-mp', { credentials: 'same-origin' });
    const j = await r.json();
    if (!j.ok) throw new Error(j.error || 'Error');
    const { estado, puedeEditar } = j.data;
    montarPresupuestoMp(root, estado, { puedeEditar, sincronizar: () => cargar(true) });
  }

  if (root) {
    cargar(false).catch(() => {
      root.innerHTML = '<p class="text-sm text-red-400">No se pudo cargar el tablero. Probá de nuevo.</p>';
    });
  }
</script>
