---
import RotacionGastoApp from './RotacionGastoApp';
---

<div>
  <header class="mb-6">
    <h2 class="text-lg font-semibold text-slate-100">Rotación y Gasto Real</h2>
    <p class="mt-1 text-sm text-slate-400">
      Rotación del inventario de materia prima por categoría (capas de valoración de Odoo) y gasto real por mes,
      por órdenes de compra confirmadas o por facturas, en pesos. Solo lectura.
    </p>
  </header>

  <RotacionGastoApp client:load />
</div>
