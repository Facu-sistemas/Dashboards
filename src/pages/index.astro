---
import BaseLayout from '../layouts/BaseLayout.astro';
import AreaCard from '../components/nav/AreaCard.astro';
import { AREAS } from '../lib/areas.config';
---

<BaseLayout title="Frontera Living — Dashboards">
  <main class="mx-auto max-w-6xl px-4 py-10">
    <header class="mb-8">
      <h1 class="text-2xl font-semibold text-slate-100">Frontera Living</h1>
      <p class="mt-1 text-sm text-slate-400">Elegí un área para ver sus indicadores.</p>
    </header>

    <div class="grid grid-cols-1 gap-4 sm:grid-cols-2 lg:grid-cols-4">
      {AREAS.map((area) => <AreaCard area={area} />)}
    </div>
  </main>
</BaseLayout>
