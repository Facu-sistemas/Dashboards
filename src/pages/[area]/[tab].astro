---
import AreaLayout from '../../layouts/AreaLayout.astro';
import PlaceholderTab from '../../components/nav/PlaceholderTab.astro';
import FacturacionTab from '../../components/finanzas/FacturacionTab.astro';
import PresupuestoProyectadoTab from '../../components/compras/PresupuestoProyectadoTab.astro';
import RotacionGastoTab from '../../components/compras/RotacionGastoTab.astro';
import RawMaterialConsumptionTab from '../../components/finanzas/RawMaterialConsumptionTab.astro';
import PoliticaVsRealTab from '../../components/finanzas/PoliticaVsRealTab.astro';
import TendenciaPreciosTab from '../../components/comercial/TendenciaPreciosTab.astro';
import CarteraClientesTab from '../../components/comercial/CarteraClientesTab.astro';
import ClientesActivosTab from '../../components/comercial/ClientesActivosTab.astro';
import TopProductosTab from '../../components/manufactura/TopProductosTab.astro';
import OeeTab from '../../components/manufactura/OeeTab.astro';
import PlanProduccionTab from '../../components/manufactura/PlanProduccionTab.astro';
import MapaDepositoTab from '../../components/almacen/MapaDepositoTab.astro';
import CarpinteriaTab from '../../components/produccion/CarpinteriaTab.astro';
import BandasTab from '../../components/produccion/BandasTab.astro';
import MulticorteTab from '../../components/produccion/MulticorteTab.astro';
import VerticalTab from '../../components/produccion/VerticalTab.astro';
import EtiquetasTab from '../../components/produccion/EtiquetasTab.astro';
import TicketsSoporteTab from '../../components/calidad/TicketsSoporteTab.astro';
import ReparacionesColchonesTab from '../../components/calidad/ReparacionesColchonesTab.astro';
import ColchonTab from '../../components/test/ColchonTab.astro';
import ConversorTab from '../../components/test/ConversorTab.astro';
import VacacionesTab from '../../components/rrhh/VacacionesTab.astro';
import CumpleanosTab from '../../components/test/CumpleanosTab.astro';
import FlujoTab from '../../components/test/FlujoTab.astro';
import FichajeTab from '../../components/test/FichajeTab.astro';
import VentasTab from '../../components/gerencia/VentasTab.astro';
import ProduccionGerenciaTab from '../../components/gerencia/ProduccionTab.astro';
import ProduccionDetalleTab from '../../components/gerencia/ProduccionDetalleTab.astro';
import FacturacionGerenciaTab from '../../components/gerencia/FacturacionTab.astro';
import CreditoChequesTab from '../../components/mejora-continua/CreditoChequesTab.astro';
import DistribucionChequesTab from '../../components/mejora-continua/DistribucionChequesTab.astro';
import { getArea } from '../../lib/areas.config';

export const prerender = false;

const { area: areaSlug, tab: tabSlug } = Astro.params;
const area = getArea(areaSlug!);
if (!area || !area.tabs.some((t) => t.slug === tabSlug) || !Astro.locals.usuario!.areasPermitidas.includes(area.slug)) {
  return Astro.rewrite('/404');
}
---

<AreaLayout areaSlug={area.slug} tabSlug={tabSlug!}>
  {area.slug === 'finanzas' && tabSlug === 'presupuesto-proyectado' && <PresupuestoProyectadoTab />}
  {area.slug === 'finanzas' && tabSlug === 'rotacion-gasto' && <RotacionGastoTab />}
  {area.slug === 'finanzas' && tabSlug === 'facturacion' && <FacturacionTab />}
  {area.slug === 'finanzas' && tabSlug === 'consumo-mp' && <RawMaterialConsumptionTab />}
  {area.slug === 'finanzas' && tabSlug === 'politica-vs-real' && <PoliticaVsRealTab />}
  {area.slug === 'comercial' && tabSlug === 'tendencia-precios' && <TendenciaPreciosTab />}
  {area.slug === 'comercial' && tabSlug === 'salud-cartera' && <CarteraClientesTab />}
  {area.slug === 'manufactura' && tabSlug === 'top-productos' && <TopProductosTab />}
  {area.slug === 'manufactura' && tabSlug === 'oee' && <OeeTab />}
  {area.slug === 'manufactura' && tabSlug === 'plan-produccion' && <PlanProduccionTab />}
  {area.slug === 'almacen' && tabSlug === 'mapa-deposito' && <MapaDepositoTab />}
  {area.slug === 'produccion' && tabSlug === 'calculadora-carpinteria' && <CarpinteriaTab />}
  {area.slug === 'produccion' && tabSlug === 'calculadora-bandas' && <BandasTab />}
  {area.slug === 'produccion' && tabSlug === 'optimizador-multicorte' && <MulticorteTab />}
  {area.slug === 'produccion' && tabSlug === 'optimizador-vertical' && <VerticalTab />}
  {area.slug === 'produccion' && tabSlug === 'etiquetas-proveedor' && <EtiquetasTab />}
  {area.slug === 'gestion-calidad' && tabSlug === 'tickets-soporte' && <TicketsSoporteTab />}
  {area.slug === 'gestion-calidad' && tabSlug === 'reparaciones-colchones' && <ReparacionesColchonesTab />}
  {area.slug === 'test' && tabSlug === 'colchon' && <ColchonTab />}
  {area.slug === 'test' && tabSlug === 'conversor' && <ConversorTab />}
  {area.slug === 'test' && tabSlug === 'cumpleanos' && <CumpleanosTab />}
  {area.slug === 'test' && tabSlug === 'flujo' && <FlujoTab />}
  {area.slug === 'test' && tabSlug === 'fichaje' && <FichajeTab />}
  {area.slug === 'gerencia-general' && tabSlug === 'ventas' && <VentasTab />}
  {area.slug === 'gerencia-general' && tabSlug === 'produccion' && <ProduccionGerenciaTab />}
  {area.slug === 'gerencia-general' && tabSlug === 'detalle-produccion' && <ProduccionDetalleTab />}
  {area.slug === 'gerencia-general' && tabSlug === 'facturacion' && <FacturacionGerenciaTab />}
  {area.slug === 'comercial' && tabSlug === 'clientes-activos' && <ClientesActivosTab />}
  {area.slug === 'rrhh' && tabSlug === 'vacaciones' && <VacacionesTab />}
  {area.slug === 'finanzas-creditos' && tabSlug === 'credito-cheques' && <CreditoChequesTab />}
  {area.slug === 'finanzas-creditos' && tabSlug === 'distribucion-cheques' && <DistribucionChequesTab />}
  {!['finanzas', 'comercial', 'manufactura', 'almacen', 'produccion', 'gestion-calidad', 'test', 'gerencia-general', 'rrhh', 'finanzas-creditos'].includes(
    area.slug
  ) && <PlaceholderTab areaName={area.name} />}
</AreaLayout>
