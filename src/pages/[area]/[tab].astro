---
import AreaLayout from '../../layouts/AreaLayout.astro';
import PlaceholderTab from '../../components/nav/PlaceholderTab.astro';
import PresupuestoComprasTab from '../../components/finanzas/PresupuestoComprasTab.astro';
import FacturacionTab from '../../components/finanzas/FacturacionTab.astro';
import TendenciaPreciosTab from '../../components/comercial/TendenciaPreciosTab.astro';
import ParetoClientesTab from '../../components/comercial/ParetoClientesTab.astro';
import TopProductosTab from '../../components/manufactura/TopProductosTab.astro';
import OeeTab from '../../components/manufactura/OeeTab.astro';
import RawMaterialConsumptionTab from '../../components/manufactura/RawMaterialConsumptionTab.astro';
import MapaDepositoTab from '../../components/almacen/MapaDepositoTab.astro';
import { getArea } from '../../lib/areas.config';

export const prerender = false;

const { area: areaSlug, tab: tabSlug } = Astro.params;
const area = getArea(areaSlug!);
if (!area || !area.tabs.some((t) => t.slug === tabSlug)) {
  return Astro.redirect('/', 302);
}
---

<AreaLayout areaSlug={area.slug} tabSlug={tabSlug!}>
  {area.slug === 'finanzas' && tabSlug === 'presupuesto-compras' && <PresupuestoComprasTab />}
  {area.slug === 'finanzas' && tabSlug === 'facturacion' && <FacturacionTab />}
  {area.slug === 'comercial' && tabSlug === 'tendencia-precios' && <TendenciaPreciosTab />}
  {area.slug === 'comercial' && tabSlug === 'top-clientes' && <ParetoClientesTab />}
  {area.slug === 'manufactura' && tabSlug === 'top-productos' && <TopProductosTab />}
  {area.slug === 'manufactura' && tabSlug === 'oee' && <OeeTab />}
  {area.slug === 'manufactura' && tabSlug === 'consumo-mp' && <RawMaterialConsumptionTab />}
  {area.slug === 'almacen' && tabSlug === 'mapa-deposito' && <MapaDepositoTab />}
  {!['finanzas', 'comercial', 'manufactura', 'almacen'].includes(area.slug) && <PlaceholderTab areaName={area.name} />}
</AreaLayout>
