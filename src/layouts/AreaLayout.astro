---
import BaseLayout from './BaseLayout.astro';
import Breadcrumb from '@/components/nav/Breadcrumb.astro';
import TabsNav from '@/components/nav/TabsNav.astro';
import { getArea } from '@/lib/areas.config';

interface Props {
  areaSlug: string;
  tabSlug: string;
}

const { areaSlug, tabSlug } = Astro.props;
const area = getArea(areaSlug);
if (!area) throw new Error(`Unknown area "${areaSlug}"`);
const tab = area.tabs.find((t) => t.slug === tabSlug);
if (!tab) throw new Error(`Unknown tab "${tabSlug}" for area "${areaSlug}"`);
---

<BaseLayout title={`${tab.name} · ${area.name} | Frontera Living`}>
  <div class="mx-auto max-w-7xl px-4 py-8">
    <!-- Cabecera sticky y translúcida: breadcrumb + título + pestañas acompañan al scrollear. -->
    <div
      id="area-sticky"
      class="group sticky top-0 z-30 -mx-4 bg-slate-950/70 px-4 pt-3 backdrop-blur-md transition-[padding] duration-500 ease-out data-[compact=true]:pt-1"
    >
      <!-- Al scrollear, breadcrumb y título colapsan (grid 1fr→0fr) y el nombre del área reaparece chico a la derecha de las pestañas. -->
      <div class="grid grid-rows-[1fr] transition-[grid-template-rows,opacity] duration-500 ease-out group-data-[compact=true]:grid-rows-[0fr] group-data-[compact=true]:opacity-0">
        <div class="min-h-0 overflow-hidden">
          <Breadcrumb area={area} tab={tab} />

          <header class="mb-4 mt-2">
            <h1 class="text-xl font-semibold text-slate-100 sm:text-2xl">{area.name}</h1>
          </header>
        </div>
      </div>

      <div class="relative">
        <TabsNav area={area} activeTabSlug={tabSlug} />
        <span
          class="pointer-events-none absolute bottom-2 right-0 hidden translate-x-6 text-sm font-semibold text-slate-300 opacity-0 transition-all duration-500 ease-out group-data-[compact=true]:translate-x-0 group-data-[compact=true]:opacity-100 sm:block"
          aria-hidden="true"
        >
          {area.name}
        </span>
      </div>
    </div>

    <main class="tab-enter mt-6">
      <slot />
    </main>
  </div>

  <!--
    La animación de .tab-enter (ver global.css) usa animation-fill-mode:
    both, que deja el transform "vigente" para siempre después de terminar
    (así es como funciona forwards: no es un bug de CSS, es la semántica
    de fill-mode). Mientras el transform sigue vigente, <main> pasa a ser
    el containing block de cualquier descendiente position:fixed (overlays,
    modales) en vez de la ventana — confirmado en vivo (2026-10-30) rompiendo
    un modal de drill-down. Sacar la clase al terminar no cambia nada visual
    (la animación ya se vio una vez) y evita el problema para cualquier
    modal, de cualquier tab, presente o futuro.
  -->
  <script is:inline>
    // Compacta la cabecera sticky con histéresis (baja a >120px, vuelve a <40px) para que
    // el cambio de altura no haga oscilar el scroll cerca del umbral.
    (() => {
      const el = document.getElementById('area-sticky');
      if (!el) return;
      let compact = false;
      const update = () => {
        const y = window.scrollY;
        const next = compact ? y > 40 : y > 120;
        if (next !== compact) {
          compact = next;
          el.dataset.compact = String(compact);
        }
      };
      window.addEventListener('scroll', update, { passive: true });
      update();
    })();
    document.querySelectorAll('main.tab-enter').forEach((el) => {
      el.addEventListener('animationend', () => el.classList.remove('tab-enter'), { once: true });
    });
  </script>
</BaseLayout>
