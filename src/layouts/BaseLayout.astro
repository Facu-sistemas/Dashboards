---
import '../styles/global.css';

interface Props {
  title: string;
}

const { title } = Astro.props;
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="robots" content="noindex, nofollow" />
    <link rel="icon" type="image/png" href="/favicon.png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <title>{title}</title>
    <script is:inline>
      // Blocking (not type=module, not deferred) and first in <head> on
      // purpose: must run before first paint or the page flashes dark
      // then flips to the stored theme a frame later.
      try {
        const stored = localStorage.getItem('theme');
        if (stored === 'light') document.documentElement.setAttribute('data-theme', 'light');
      } catch {
        // localStorage can throw in locked-down contexts (private mode,
        // disabled storage) — default theme (dark) is still correct.
      }
    </script>
  </head>
  <body class="min-h-screen bg-slate-950 text-slate-100 antialiased">
    <div
      id="page-loading-bar"
      class="pointer-events-none fixed inset-x-0 top-0 z-[100] h-0.5 origin-left scale-x-0 bg-brand-500 transition-transform ease-out"
    >
    </div>

    <button
      id="theme-toggle"
      type="button"
      aria-label="Cambiar entre modo oscuro y claro"
      class="fixed right-4 top-4 z-40 flex h-9 w-9 items-center justify-center rounded-full border border-slate-700 bg-slate-900 text-slate-300 shadow-sm transition-colors hover:border-brand-500 hover:text-brand-500"
    >
      <svg id="theme-toggle-sun" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="hidden h-4.5 w-4.5">
        <circle cx="12" cy="12" r="4" />
        <path d="M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M4.93 19.07l1.41-1.41M17.66 6.34l1.41-1.41" />
      </svg>
      <svg id="theme-toggle-moon" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="hidden h-4.5 w-4.5">
        <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79Z" />
      </svg>
    </button>
    <script is:inline>
      (function () {
        const button = document.getElementById('theme-toggle');
        const sunIcon = document.getElementById('theme-toggle-sun');
        const moonIcon = document.getElementById('theme-toggle-moon');
        if (!button || !sunIcon || !moonIcon) return;

        function currentTheme() {
          return document.documentElement.getAttribute('data-theme') === 'light' ? 'light' : 'dark';
        }

        function syncIcon() {
          const isLight = currentTheme() === 'light';
          // Sun means "currently light" (shows what's active), click swaps to the other.
          sunIcon.classList.toggle('hidden', !isLight);
          moonIcon.classList.toggle('hidden', isLight);
        }

        button.addEventListener('click', () => {
          const next = currentTheme() === 'light' ? 'dark' : 'light';
          if (next === 'light') {
            document.documentElement.setAttribute('data-theme', 'light');
          } else {
            document.documentElement.removeAttribute('data-theme');
          }
          try {
            localStorage.setItem('theme', next);
          } catch {
            // best-effort persistence only
          }
          syncIcon();
          // Chart components hold their own hex colors read from CSS vars
          // at mount time (SVG attrs, not Tailwind classes) — they can't
          // see this attribute change on their own, so nudge them.
          window.dispatchEvent(new CustomEvent('themechange', { detail: { theme: next } }));
        });

        syncIcon();
      })();
    </script>

    <slot />
    <script>
      // Full multi-page navigation (no client router), so this can't be a
      // React island — it has to be plain DOM/JS living in the layout that
      // survives up to the moment the browser actually unloads the page.
      const bar = document.getElementById('page-loading-bar');

      function internalNavAnchor(e: MouseEvent): HTMLAnchorElement | null {
        if (e.defaultPrevented || e.button !== 0 || e.metaKey || e.ctrlKey || e.shiftKey || e.altKey) return null;
        const anchor = (e.target as HTMLElement | null)?.closest('a[href]') as HTMLAnchorElement | null;
        if (!anchor) return null;
        if (anchor.target && anchor.target !== '_self') return null;
        if (anchor.hasAttribute('download')) return null;

        const url = new URL(anchor.href, location.href);
        if (url.origin !== location.origin) return null;
        // Same-page hash link (e.g. an anchor jump) — no real navigation happens.
        if (url.pathname === location.pathname && url.search === location.search && url.hash) return null;
        return anchor;
      }

      document.addEventListener('click', (e) => {
        if (!bar || !internalNavAnchor(e)) return;
        bar.style.transitionDuration = '0ms';
        bar.style.transform = 'scaleX(0)';
        void bar.offsetWidth; // force reflow so the next transform change animates

        // Two-stage animation: an immediate, clearly-visible jump first, then
        // a slow crawl. A fast tab-to-tab swap (Finanzas > Presupuesto to
        // Finanzas > Facturación, both cheap SSR queries) can finish in a
        // couple hundred ms — with a single 4s transition the bar barely
        // moves before the page swaps out, which reads as "nothing
        // happened." The upfront jump guarantees visible feedback even then.
        bar.style.transitionDuration = '150ms';
        bar.style.transform = 'scaleX(0.35)';
        window.setTimeout(() => {
          if (!bar) return;
          bar.style.transitionDuration = '4000ms';
          bar.style.transform = 'scaleX(0.85)';
        }, 150);
      });

      // If the destination page is restored from bfcache instead of a fresh
      // load, reset instantly instead of leaving a stale bar on screen.
      window.addEventListener('pageshow', () => {
        if (!bar) return;
        bar.style.transitionDuration = '0ms';
        bar.style.transform = 'scaleX(0)';
      });
    </script>
  </body>
</html>
