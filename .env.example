# --- Odoo connection (server-side ONLY, never exposed to the client) ---
ODOO_URL=https://your-odoo-instance.odoo.com
ODOO_DB=your_database_name
ODOO_USER_EMAIL=api-user@yourcompany.com
ODOO_API_KEY=your_odoo_api_key

# Optional: skip the login/uid handshake on every cold start by pinning
# a known uid for the API user (found once via odoo.authenticate).
# ODOO_UID=7

# --- Cache ---
# Short in-memory TTL (ms) for repeated identical queries within a burst
# of requests. Keeps Odoo from being hammered by multiple chart widgets
# reading overlapping data, without staling the dashboard.
ODOO_CACHE_TTL_MS=15000

# --- Supabase (auth + per-area permissions) ---
# URL and anon key are safe to expose to the client (PUBLIC_ prefix) —
# the anon key is useless without RLS, and with RLS configured correctly
# it stays safe. Find both under Project Settings > API.
PUBLIC_SUPABASE_URL=https://your-project.supabase.co
PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key

# Service-role key: bypasses RLS entirely. NEVER prefix with PUBLIC_.
# Server-side only, used exclusively by src/lib/supabase/admin.ts for
# the admin panel that creates area accounts and toggles permissions.
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key